# ===================================================================
# HOMELINE INTERIO — Environment Configuration
# Interactive Concept Demo by Nats LAB
# ===================================================================

# Node Environment ('development' | 'production')
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (CORS allowed origin)
CLIENT_ORIGIN=http://localhost:5173

# Frontend API Base URL (used by Vite client)
VITE_API_URL=http://localhost:5000/api

# -------------------------------------------------------------------
# Database Configuration (MongoDB)
# -------------------------------------------------------------------
# Provide a MongoDB connection string (e.g. MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/homeline_interio?retryWrites=true&w=majority
# In development, if MONGODB_URI is left empty, the server operates in
# fallback in-memory storage for demo leads and logs this status clearly.
MONGODB_URI=

# -------------------------------------------------------------------
# Security & JWT Authentication
# -------------------------------------------------------------------
# Secret key used to sign and verify administrator JWT tokens.
# Change this to a secure random 32+ character string in production.
JWT_SECRET=homeline-interio-demo-jwt-secret-key-change-in-prod
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------------
# Administrator Bootstrap Provisioning
# -------------------------------------------------------------------
# Initial credentials used to seed or authenticate the administrator dashboard.
ADMIN_NAME="Principal Interior Designer"
ADMIN_EMAIL=admin@homelineinterio.com
ADMIN_PASSWORD=Homeline@2026Admin

# -------------------------------------------------------------------
# AI Provider Integration
# -------------------------------------------------------------------
# Supported providers:
#   'fallback'  - Deterministic knowledge engine (works out of the box, zero API keys required)
#   'gemini'    - Google Gemini AI (requires AI_API_KEY)
AI_PROVIDER=fallback

# Google Gemini API key (only required if AI_PROVIDER=gemini)
AI_API_KEY=

# Model identifier
AI_MODEL=gemini-1.5-flash
